generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// System-wide settings. Always exactly one row with id = 1.
model Setting {
  id                      Int      @id @default(1)
  /// Working weekdays: 0 = Sunday ... 6 = Saturday
  workingDays             Int[]    @default([1, 2, 3, 4, 5])
  defaultDailyHours       Float    @default(8)
  defaultSprintLengthDays Int      @default(14)
  updatedAt               DateTime @updatedAt
}

model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String
  createdAt DateTime @default(now())
}

model Squad {
  id               String            @id @default(cuid())
  name             String            @unique
  description      String            @default("")
  /// Overrides the system default sprint length (days) for this squad's LOBs
  sprintLengthDays Int?
  lobs             LineOfBusiness[]
  memberships      SquadMembership[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

/// A Line of Business (LOB) is the "project". Owned by exactly one squad.
model LineOfBusiness {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String   @default("")
  squadId          String
  squad            Squad    @relation(fields: [squadId], references: [id], onDelete: Restrict)
  /// Overrides the squad / system sprint length (days)
  sprintLengthDays Int?
  /// Short code used in item IDs, e.g. "RB" -> RB-12
  key              String     @unique
  /// Next item number to hand out in this LOB
  nextItemNumber   Int        @default(1)
  workItems        WorkItem[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([squadId])
}

/// Squad member. A name only - members do not log in.
model Member {
  id          String            @id @default(cuid())
  name        String
  role        String            @default("")
  active      Boolean           @default(true)
  memberships SquadMembership[]
  leaves      Leave[]
  assignments WorkItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

/// Hours per week a member gives to a squad.
model SquadMembership {
  id          String @id @default(cuid())
  memberId    String
  squadId     String
  weeklyHours Float
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  squad       Squad  @relation(fields: [squadId], references: [id], onDelete: Restrict)

  @@unique([memberId, squadId])
  @@index([squadId])
}

/// Full days off, start and end inclusive.
model Leave {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([memberId])
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  BUG
  TASK
}

/// Story/Bug: NEW, APPROVED, COMMITTED, DONE. Task: NEW, IN_PROGRESS, DONE.
/// Epic/Feature progress is calculated from their children; their status stays NEW.
enum WorkItemStatus {
  NEW
  APPROVED
  COMMITTED
  IN_PROGRESS
  DONE
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

model WorkItem {
  id                 String          @id @default(cuid())
  type               WorkItemType
  /// Sequential number inside the LOB (shown as KEY-number)
  number             Int
  title              String
  description        String          @default("")
  acceptanceCriteria String          @default("")
  status             WorkItemStatus  @default(NEW)
  priority           Priority        @default(MEDIUM)
  /// Manual order among siblings (lower comes first)
  rank               Float           @default(0)
  lobId              String
  lob                LineOfBusiness  @relation(fields: [lobId], references: [id], onDelete: Restrict)
  parentId           String?
  parent             WorkItem?       @relation("WorkItemTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           WorkItem[]      @relation("WorkItemTree")
  /// Tasks only
  assigneeId         String?
  assignee           Member?         @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Tasks only
  estimateHours      Float?
  blocked            Boolean         @default(false)
  blockedReason      String          @default("")
  /// Set when status becomes DONE, cleared when it leaves DONE
  doneAt             DateTime?
  history            WorkItemHistory[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([lobId, number])
  @@index([parentId])
  @@index([assigneeId])
  @@index([lobId, type])
}

/// One row per changed field, used for audit and for reports (cycle time, burndown).
model WorkItemHistory {
  id         String   @id @default(cuid())
  workItemId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  /// created, title, status, priority, assignee, estimate, blocked, parent
  field      String
  oldValue   String?
  newValue   String?
  changedAt  DateTime @default(now())

  @@index([workItemId, changedAt])
  @@index([field, changedAt])
}
